ARG APP_IMAGE=uav-web-check
FROM ${APP_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends chromium nodejs git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir pytest PySocks customtkinter Pillow
ENV CHROME_BIN=chromium \
    CONFIG_DIR=/tmp/uav-ci-config \
    APPDATA=/tmp/uav-ci-appdata \
    DOWNLOAD_DIR=/tmp/uav-ci-downloads \
    UAV_FIRECRAWL_ENABLED=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTEST_ADDOPTS="-p no:cacheprovider" \
    HOME=/tmp
ENTRYPOINT ["bash", "scripts/check_web.sh"]
